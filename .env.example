# ==========================================
# RASTA IT COM - TEMPLATE KONFIGURASI (.env.example)
# Salin file ini menjadi .env di root direktori
# ==========================================

# BACKEND FASTIFY SERVER
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# DATABASE MYSQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rasta_it_db

# SECURITY
JWT_SECRET=your_jwt_secret_key_here

# STORAGE & UPLOADS
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# FRONTEND VITE
VITE_APP_TITLE=RASTA IT COM
VITE_API_BASE_URL=http://localhost:5000
VITE_PORT=3000
